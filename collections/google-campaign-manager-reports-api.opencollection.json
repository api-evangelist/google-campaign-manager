          "http": {
            "method": "GET",
            "url": "https://dfareporting.googleapis.com/dfareporting/v4/userprofiles/:profileId/reports",
            "params": [
              {
                "name": "profileId",
                "value": "123456",
                "type": "path",
                "description": "The Campaign Manager 360 user profile ID. Each user has a profile for each account they have access to."
              },
              {
                "name": "scope",
                "value": "",
