              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a report. Configure the report type, criteria with dimensions and metrics, date range, and optional scheduling for automated delivery."
        },
        {
          "info": {
            "name": "Google Campaign Manager Get a Report",
